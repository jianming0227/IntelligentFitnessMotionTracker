# .understandignore — focus analysis on lib/ Dart source only
#
# Built-in defaults (always excluded unless negated):
#   build/, .git/, *.lock, etc.

# Platform folders — not Dart source
android/
ios/
linux/
macos/
web/
windows/

# Flutter/Dart tooling — generated files
.dart_tool/
.pub-cache/
.pub/
.flutter-plugins-dependencies
.flutter-plugins

# Config/build files at root — not application logic
pubspec.lock
analysis_options.yaml
devtools_options.yaml
*.iml
*.ipr
*.iws

# Docs and requirements — skip from graph
README.md
Requirements.md
TRACKER.md
